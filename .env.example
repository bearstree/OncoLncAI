# Example values. Export them in the process environment or configure them in the deployment platform.
ONCOLNCAI_ENVIRONMENT=development
ONCOLNCAI_LOG_LEVEL=INFO
ONCOLNCAI_CACHE_DIR=.cache/oncolncai
ONCOLNCAI_LLM_PROVIDER=ollama
ONCOLNCAI_LLM_MODEL=qwen2.5-coder:14b
ONCOLNCAI_LLM_BASE_URL=http://127.0.0.1:11434
ONCOLNCAI_LLM_TIMEOUT_SECONDS=60
# Browser-safe local default. The Docker image overrides this with 0.0.0.0.
ONCOLNCAI_SERVER_NAME=127.0.0.1
ONCOLNCAI_SERVER_PORT=7860
# Optional release provenance recorded in REAL run manifests.
# ONCOLNCAI_SOURCE_GIT_SHA=
# Required only when ONCOLNCAI_LLM_PROVIDER=openai. Never commit a real key.
# ONCOLNCAI_LLM_API_KEY=
# Optional NCBI E-utilities key for higher PubMed rate limits. Never commit a real key.
# ONCOLNCAI_NCBI_API_KEY=
# Optional path used by examples/localization_smoke_test.py.
# ONCOLNCAI_LOCALIZATION_PROJECT=C:\path\to\Deploy_lncrna
# Optional pinned Python executable for isolated predictor dependencies.
# ONCOLNCAI_LOCALIZATION_PYTHON=C:\path\to\envs\lncrna-space-py310\python.exe
